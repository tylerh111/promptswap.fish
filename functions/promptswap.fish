# promptswap:
#   * `promptswap choose <name>` chooses a prompt (persisted).
#   * `promptswap show [<name>...]` shows prompts.
#   * `promptswap list` lists available prompts.
#
# Installed prompts are function files named `promptswap.<name>.fish` (e.g.
# installed with fisher) and MUST define `fish_prompt` and/or
# `fish_right_prompt`. Installed prompts take precedence over builtin prompts.
#
# Choosing a prompt overwrites `fish_prompt.fish` and `fish_right_prompt.fish`
# in ~/.config/fish/functions with the contents of the prompt.

function promptswap --description 'Swap fish prompts'
    set -l cmd $argv[1]
    set -e argv[1]

    switch "$cmd"
        case -v --version
            echo "promptswap v0.2"

        case "" -h --help
            echo "usage: promptswap choose <prompt>      Choose a prompt"
            echo "       promptswap show  [<prompt>...]  Show prompts (default: all)"
            echo "       promptswap list                 List available prompts"
            echo "       promptswap -v|--version         Print version"
            echo "       promptswap -h|--help            Print help"

        case choose
            if test (count $argv) -ne 1
                echo "usage: promptswap choose <prompt>" >&2
                return 1
            end
            set -l name $argv[1]
            if not contains -- $name (__promptswap_names)
                echo "promptswap: no such prompt '$name'" >&2
                return 1
            end

            set -l content (__promptswap_read $name | string collect)
            set -l dir $__fish_config_dir/functions
            set -l header "# Generated by promptswap from '$name'. Use `promptswap choose` to change it."
            command mkdir -p $dir
            or return

            for func in fish_prompt fish_right_prompt
                set -l file $dir/$func.fish

                # Don't silently clobber a prompt the user wrote themselves.
                if test -f $file
                    read -l first_line <$file
                    if not string match -q -- '# Generated by promptswap*' "$first_line"
                        command cp $file $file.bak
                        echo "promptswap: backed up $file to $file.bak" >&2
                    end
                end

                if __promptswap_defines $func "$content"
                    printf '%s\n' $header $content >$file
                else if test $func = fish_prompt
                    # Only a right prompt was given, so fall back to the default left prompt.
                    printf '%s\n' $header (__promptswap_read_builtin default | string collect) >$file
                else
                    printf '%s\n' $header "function $func" end >$file
                end
            end

            # Reloads the prompt in every running shell (see conf.d/promptswap.fish).
            set -U promptswap_current $name

        case show
            set -q argv[1]; or set argv (__promptswap_names)
            set -l fish (status fish-path)
            for name in $argv
                if not contains -- $name (__promptswap_names)
                    echo "promptswap: no such prompt '$name'" >&2
                    return 1
                end
                echo -s (set_color --underline) $name (set_color normal)
                __promptswap_read $name | $fish -c '
                    functions -e fish_right_prompt
                    source
                    false
                    fish_prompt
                    echo (set_color normal)
                    if functions -q fish_right_prompt
                        echo right prompt: (false; fish_right_prompt)
                    end'
                echo
            end

        case list
            for name in (__promptswap_names)
                if test "$name" = "$promptswap_current"
                    echo "* $name"
                else
                    echo "  $name"
                end
            end

        case '*'
            echo "promptswap: unknown command '$cmd'" >&2
            return 1
    end
end

function __promptswap_names
    begin
        __promptswap_installed
        __promptswap_builtins
    end | sort -u
end

function __promptswap_installed
    set -l files $fish_function_path/promptswap.*.fish
    path basename -E $files | string replace -r '^promptswap\.' ''
end

function __promptswap_builtins
    # Newer versions of fish embed the builtin prompts in the binary, older
    # versions ship them in the data directory.
    for dir in prompts tools/web_config/sample_prompts
        set -l files (status list-files $dir 2>/dev/null)
        and path basename -E $files
        and return
    end
    set -l files $__fish_data_dir/tools/web_config/sample_prompts/*.fish
    path basename -E $files
end

function __promptswap_read -a name
    set -l files (path filter -f $fish_function_path/promptswap.$name.fish)
    if set -q files[1]
        cat $files[1]
    else
        __promptswap_read_builtin $name
    end
end

function __promptswap_read_builtin -a name
    for dir in prompts tools/web_config/sample_prompts
        status get-file $dir/$name.fish 2>/dev/null
        and return
    end
    cat $__fish_data_dir/tools/web_config/sample_prompts/$name.fish
end

function __promptswap_defines -a func content
    string match -rq -- '(^|\n)\s*function\s+'$func'(\s|;|$)' $content
end
